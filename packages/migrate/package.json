{
  "name": "@graph-om/migrate",
  "version": "1.0.0",
  "description": "Graph-OM migration system - schema versioning and database migrations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/graph-om.git",
    "directory": "packages/migrate"
  },
  "homepage": "https://github.com/frontal-labs/graph-om/tree/master/packages/migrate#readme",
  "bugs": {
    "url": "https://github.com/frontal-labs/graph-om/issues"
  },
  "keywords": [
    "migration",
    "schema",
    "versioning",
    "graph-om"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist .turbo coverage",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@graph-om/sdk": "workspace:*",
    "@types/node": "^26.6.6",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
