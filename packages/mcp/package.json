{
  "name": "@graph-kit/mcp",
  "version": "0.0.1",
  "description": "Graph-Kit MCP (Model Context Protocol) server",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/graph-kit.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/frontal-labs/graph-kit/tree/master/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/frontal-labs/graph-kit/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "graph-kit",
    "graph-database"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist .turbo coverage",
    "build": "tsup && tsc --declaration --emitDeclarationOnly --outDir dist --composite false --incremental false",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@graph-kit/sdk": "workspace:*",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
