{
  "name": "graph-om",
  "version": "1.0.0",
  "private": true,
  "description": "Graph-OM - Prisma-like DX for graph databases (monorepo)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/graph-om.git"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "size": "pnpm build && size-limit",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "test:coverage": "turbo run test:coverage",
    "test:root": "vitest run",
    "test:root:ci": "vitest run --reporter=verbose",
    "benchmark": "pnpm --filter @graph-om/sdk run benchmark",
    "benchmark:ci": "pnpm --filter @graph-om/sdk run benchmark:ci",
    "lint": "ultracite check",
    "typecheck": "turbo run typecheck",
    "format": "ultracite fix",
    "format:check": "ultracite check",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^2.27.1",
    "@size-limit/file": "^14.3.0",
    "@t3-oss/env-core": "^0.13.11",
    "@types/node": "^20.10.0",
    "husky": "^9.1.7",
    "size-limit": "^14.3.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "ultracite": "^8.0.1",
    "vite": "^7.0.0",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "postcss@8": "^8.5.23",
      "nanoid@3": "^3.3.18",
      "source-map-js": "^1.2.2",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "tar@6": "^7.5.21",
      "tar@7": "^7.5.21",
      "@opentelemetry/core@2": "^2.8.0"
    },
    "patchedDependencies": {
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
    }
  }
}
